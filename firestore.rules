rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net - Default Deny Catch-All
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Root User Profile Document
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && isValidId(userId);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);

      // User Settings Subcollection (e.g. preferences, timer settings, themes)
      match /settings/{settingId} {
        allow read, write: if isOwner(userId);
      }

      // Subjects Subcollection
      match /subjects/{subjectId} {
        allow read, write: if isOwner(userId);
      }

      // Tasks Subcollection
      match /tasks/{taskId} {
        allow read, write: if isOwner(userId);
      }

      // Focus Sessions Subcollection
      match /sessions/{sessionId} {
        allow read, write: if isOwner(userId);
      }

      // Goals Subcollection
      match /goals/{goalId} {
        allow read, write: if isOwner(userId);
      }

      // Study Statistics Subcollection (e.g. summary, daily metrics)
      match /statistics/{statId} {
        allow read, write: if isOwner(userId);
      }
    }
  }
}

